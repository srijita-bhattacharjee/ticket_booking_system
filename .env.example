# ─────────────────────────────────────────────────────────────────────────────
# TicketVerse Backend — Environment Variables Reference
# Copy this file to backend/.env and fill in every value.
# NEVER commit the actual .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Local:       postgresql://postgres:yourpassword@localhost:5432/ticket_booking
# Neon.tech:   postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Supabase:    postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/ticket_booking?schema=public"

# ── Redis ─────────────────────────────────────────────────────────────────────
# For local dev, leave REDIS_URL empty and set REDIS_HOST + REDIS_PORT.
# For production (Upstash), set only REDIS_URL — it takes priority.
# Upstash format: rediss://default:<password>@<region>.upstash.io:6379
REDIS_URL=""
REDIS_HOST="localhost"
REDIS_PORT=6379

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="REPLACE_WITH_64_BYTE_RANDOM_HEX_STRING"
JWT_EXPIRES_IN="7d"

# ── HMAC QR Ticket Signing ────────────────────────────────────────────────────
# Generate a separate secure key: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
HMAC_SECRET="REPLACE_WITH_ANOTHER_64_BYTE_RANDOM_HEX_STRING"

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Use rzp_test_* keys for staging, rzp_live_* keys for production
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Free tier: from address MUST be onboarding@resend.dev (until you verify a domain)
# With a verified domain you can use: TicketVerse <noreply@yourdomain.com>
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM="TicketVerse <onboarding@resend.dev>"

# ── AI Chatbot (Google Gemini) ────────────────────────────────────────────────
GEMINI_API_KEY="your_google_gemini_api_key"

# ── CORS (comma-separated list of allowed frontend origins) ───────────────────
# Example: https://ticketverse.vercel.app,https://www.ticketverse.in
ALLOWED_ORIGINS="http://localhost:3000"

# ── Frontend URL (used in waitlist offer links in emails) ─────────────────────
FRONTEND_URL="http://localhost:3000"
