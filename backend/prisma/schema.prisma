// Prisma Schema for Ticket Booking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

enum EventType {
  MOVIE
  CONCERT
  THEATRE
  SPORTS
  COMEDY
  WORKSHOP
}

enum EventStatus {
  UPCOMING
  ON_SALE
  SOLD_OUT
  COMPLETED
  CANCELLED
}

enum SeatCategory {
  PREMIUM
  STANDARD
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
}

enum HoldStatus {
  ACTIVE
  EXPIRED
  RELEASED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  FULFILLED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum TicketStatus {
  VALID
  CHECKED_IN
  CANCELLED
}

enum PartnershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String          @map("password_hash")
  role         Role            @default(CUSTOMER)
  createdAt    DateTime        @default(now()) @map("created_at")
  
  venues       Venue[]
  events       Event[]
  holds        Hold[]
  bookings     Booking[]
  waitlists    WaitlistEntry[]
  partnerships PartnershipProof[]

  @@map("users")
}

model Venue {
  id          String      @id @default(uuid())
  name        String
  location    String
  imageUrl    String?     @map("image_url")
  createdById String      @map("created_by")
  createdAt   DateTime    @default(now()) @map("created_at")

  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  seats       VenueSeat[]
  events      Event[]
  foodStalls  FoodStall[]

  @@map("venues")
}

model VenueSeat {
  id         String       @id @default(uuid())
  venueId    String       @map("venue_id")
  rowNumber  String       @map("row_number")
  seatNumber Int          @map("seat_number")
  category   SeatCategory @default(STANDARD)

  venue      Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  eventSeats EventSeat[]

  @@unique([venueId, rowNumber, seatNumber])
  @@map("venue_seats")
}

model Event {
  id          String      @id @default(uuid())
  organiserId String      @map("organiser_id")
  venueId     String      @map("venue_id")
  title       String
  description String
  eventType   EventType   @default(MOVIE) @map("event_type")
  eventDate   DateTime    @map("event_date")
  startTime   String      @map("start_time")
  imageUrl    String?     @map("image_url")
  trailerUrl  String?     @map("trailer_url")
  status      EventStatus @default(ON_SALE)
  createdAt   DateTime    @default(now()) @map("created_at")

  organiser   User        @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  seats       EventSeat[]
  holds       Hold[]
  bookings    Booking[]
  waitlists   WaitlistEntry[]
  coupons     FoodCoupon[]

  @@map("events")
}

model EventSeat {
  id          String       @id @default(uuid())
  eventId     String       @map("event_id")
  venueSeatId String       @map("venue_seat_id")
  category    SeatCategory
  price       Float
  status      SeatStatus   @default(AVAILABLE)
  version     Int          @default(0)

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  venueSeat   VenueSeat    @relation(fields: [venueSeatId], references: [id], onDelete: Cascade)
  holdSeats   HoldSeat[]
  bookingSeats BookingSeat[]
  offers      WaitlistOffer[]

  @@unique([eventId, venueSeatId])
  @@map("event_seats")
}

model Hold {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  eventId   String     @map("event_id")
  expiresAt DateTime   @map("expires_at")
  status    HoldStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats     HoldSeat[]

  @@map("holds")
}

model HoldSeat {
  holdId      String   @map("hold_id")
  eventSeatId String   @map("event_seat_id")

  hold        Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  eventSeat   EventSeat @relation(fields: [eventSeatId], references: [id], onDelete: Cascade)

  @@id([holdId, eventSeatId])
  @@map("hold_seats")
}

model Booking {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  eventId          String        @map("event_id")
  bookingReference String        @unique @map("booking_reference")
  totalAmount      Float         @map("total_amount")
  discountAmount   Float         @default(0) @map("discount_amount")
  couponCode       String?       @map("coupon_code")
  status           BookingStatus @default(CONFIRMED)
  idempotencyKey   String?       @unique @map("idempotency_key")
  refundEligible   Boolean       @default(true) @map("refund_eligible")
  createdAt        DateTime      @default(now()) @map("created_at")
  cancelledAt      DateTime?     @map("cancelled_at")

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats            BookingSeat[]
  tickets          Ticket[]
  addons           BookingAddon[]

  @@map("bookings")
}

model BookingSeat {
  bookingId   String   @map("booking_id")
  eventSeatId String   @map("event_seat_id")

  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  eventSeat   EventSeat @relation(fields: [eventSeatId], references: [id], onDelete: Cascade)

  @@id([bookingId, eventSeatId])
  @@map("booking_seats")
}

model WaitlistEntry {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  eventId   String         @map("event_id")
  category  SeatCategory
  position  Int
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now()) @map("created_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offers    WaitlistOffer[]

  @@map("waitlist_entries")
}

model WaitlistOffer {
  id              String        @id @default(uuid())
  waitlistEntryId String        @map("waitlist_entry_id")
  eventSeatId     String        @map("event_seat_id")
  offerToken      String        @unique @map("offer_token")
  expiresAt       DateTime      @map("expires_at")
  status          OfferStatus   @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  waitlistEntry   WaitlistEntry @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  eventSeat       EventSeat     @relation(fields: [eventSeatId], references: [id], onDelete: Cascade)

  @@map("waitlist_offers")
}

model Ticket {
  id          String       @id @default(uuid())
  bookingId   String       @map("booking_id")
  qrToken     String       @unique @map("qr_token")
  status      TicketStatus @default(VALID)
  issuedAt    DateTime     @default(now()) @map("issued_at")
  checkedInAt DateTime?    @map("checked_in_at")

  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("tickets")
}

model FoodStall {
  id          String     @id @default(uuid())
  venueId     String?    @map("venue_id")
  name        String
  description String
  location    String
  imageUrl    String?    @map("image_url")
  createdAt   DateTime   @default(now()) @map("created_at")

  venue          Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  items          MenuItem[]
  partnerships   PartnershipProof[]
  coupons        FoodCoupon[]

  @@map("food_stalls")
}

model MenuItem {
  id          String     @id @default(uuid())
  stallId     String     @map("stall_id")
  name        String
  description String
  category    String
  price       Float
  imageUrl    String?    @map("image_url")
  isAvailable Boolean    @default(true) @map("is_available")
  createdAt   DateTime   @default(now()) @map("created_at")

  stall         FoodStall      @relation(fields: [stallId], references: [id], onDelete: Cascade)
  bookingAddons BookingAddon[]

  @@map("menu_items")
}

model PartnershipProof {
  id            String            @id @default(uuid())
  organiserId   String            @map("organiser_id")
  foodStallId   String            @map("food_stall_id")
  partnerName   String            @map("partner_name")
  documentUrl   String            @map("document_url")
  agreementRef  String            @map("agreement_ref")
  status        PartnershipStatus @default(PENDING)
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  organiser     User              @relation(fields: [organiserId], references: [id], onDelete: Cascade)
  foodStall     FoodStall         @relation(fields: [foodStallId], references: [id], onDelete: Cascade)
  coupons       FoodCoupon[]

  @@map("partnership_proofs")
}

model FoodCoupon {
  id            String            @id @default(uuid())
  eventId       String?           @map("event_id")
  partnershipId String            @map("partnership_id")
  foodStallId   String            @map("food_stall_id")
  code          String            @unique
  title         String
  description   String
  discountPercent Float?          @map("discount_percent")
  discountAmount  Float?          @map("discount_amount")
  minSpend      Float             @default(0) @map("min_spend")
  imageUrl      String?           @map("image_url")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at")

  event         Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  partnership   PartnershipProof  @relation(fields: [partnershipId], references: [id], onDelete: Cascade)
  foodStall     FoodStall         @relation(fields: [foodStallId], references: [id], onDelete: Cascade)

  @@map("food_coupons")
}

model BookingAddon {
  id          String   @id @default(uuid())
  bookingId   String   @map("booking_id")
  menuItemId  String   @map("menu_item_id")
  quantity    Int      @default(1)
  price       Float

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("booking_addons")
}
